{
  "openapi": "3.1.1",
  "info": {
    "title": "SortingVisualizer | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7155"
    },
    {
      "url": "http://localhost:5007"
    }
  ],
  "paths": {
    "/api/Sort": {
      "post": {
        "tags": [
          "Sort"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SortRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SortRequest": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string"
          },
          "values": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          "order": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Sort"
    }
  ]
}