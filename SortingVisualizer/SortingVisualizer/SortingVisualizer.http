@SortingVisualizer_HostAddress = http://localhost:5007

# ==================== SELECTION SORT ====================

### 01. Selection Sort | Mảng chẵn - tăng dần
# Expected: 200 OK; sorted = [1, 2, 4, 5]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5, 2, 4, 1],
    "order": "asc"
}

### 02. Selection Sort | Mảng chẵn - giảm dần
# Expected: 200 OK; sorted = [5, 4, 2, 1]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5, 2, 4, 1],
    "order": "desc"
}

### 03. Selection Sort | Mảng lẻ
# Expected: 200 OK; sorted = [1, 2, 3, 4, 5]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5, 2, 4, 1, 3],
    "order": "asc"
}

### 04. Selection Sort | Mảng rỗng
# Expected: 200 OK; sorted = []; comparisons = swaps = moves = 0
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [],
    "order": "asc"
}

### 05. Selection Sort | Một phần tử
# Expected: 200 OK; sorted = [5]; comparisons = swaps = moves = 0
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5],
    "order": "asc"
}

### 06. Selection Sort | Phần tử trùng lặp
# Expected: 200 OK; sorted = [1, 2, 3, 3]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [3, 1, 3, 2],
    "order": "asc"
}

### 07. Selection Sort | Số âm và số 0
# Expected: 200 OK; sorted = [-3, -1, 0, 5]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [-3, 5, 0, -1],
    "order": "asc"
}

### 08. Selection Sort | Mảng đã tăng dần
# Expected: 200 OK; sorted = [1, 2, 3, 4, 5]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [1, 2, 3, 4, 5],
    "order": "asc"
}

### 09. Selection Sort | Tất cả phần tử bằng nhau
# Expected: 200 OK; sorted = [4, 4, 4, 4]
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [4, 4, 4, 4],
    "order": "asc"
}
###
