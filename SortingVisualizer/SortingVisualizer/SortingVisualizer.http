@SortingVisualizer_HostAddress = http://localhost:5007

### Kiểm thử Selection Sort tăng dần
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5, 2, 4, 1],
    "order": "asc"
}

###

### Kiểm thử Selection Sort giảm dần
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5, 2, 4, 1],
    "order": "desc"
}

###

### Kiểm thử mảng rỗng
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [],
    "order": "asc"
}

###

### Kiểm thử mảng có một phần tử
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [5],
    "order": "asc"
}

###

### Kiểm thử mảng có phần tử trùng lặp
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [3, 1, 3, 2],
    "order": "asc"
}

###

### Kiểm thử mảng có số âm
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": [-3, 5, 0, -1],
    "order": "asc"
}

###

### Kiểm thử mảng null
POST {{SortingVisualizer_HostAddress}}/api/sort
Content-Type: application/json

{
    "algorithm": "selection",
    "values": null,
    "order": "asc"
}

###

